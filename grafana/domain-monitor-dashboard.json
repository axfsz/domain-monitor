      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "domain_monitor_status_level{group=~\"$group\",domain=~\"$domain\",agent=~\"$agent\",region=~\"$region\"} > 0",
