      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg by (group) (domain_monitor_up{group=~\"$group\",domain=~\"$domain\",agent=~\"$agent\",region=~\"$region\"}) * 100",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 10,
      "type": "table",
